# replay requires no API key and reads the committed synthetic demo fixtures.
LLM_MODE=replay
LLM_MODEL=claude-sonnet-4-6

# Required only for live or record. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional local paths. Docker Compose sets DATA_DIR=/app/runtime.
# DATA_DIR=data/runtime
# CACHE_DIR=fixtures/llm_cache
# POLICY_PATH=config/policy.yaml
